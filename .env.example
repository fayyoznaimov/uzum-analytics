# PostgreSQL
POSTGRES_DB=uzum_analytics
POSTGRES_USER=uzum
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://uzum:replace-with-a-long-random-password@postgres:5432/uzum_analytics?schema=public

# API security
API_PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
# Exactly 32 random bytes encoded as base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-min-12
RESET_ADMIN_PASSWORD=false
SEED_DEMO_DATA=false

# Initial shop. Token and Shop ID can later be changed in UI.
DEFAULT_SHOP_ID=
DEFAULT_SHOP_NAME=

# Domain / CORS
WEB_ORIGIN=https://analytics.example.com
NEXT_PUBLIC_API_URL=/api

# Synchronization
SYNC_CRON=*/15 * * * *
SUPPLY_SYNC_CRON=*/10 * * * *
SLOT_WATCH_CRON=*/5 * * * *
REVIEW_SYNC_CRON=*/10 * * * *
ORDER_SYNC_MAX_PAGES=200
PRODUCT_SYNC_MAX_PAGES=100
REVIEW_SYNC_PAGE_SIZE=100
REVIEW_SYNC_MAX_PAGES=100
LOW_STOCK_THRESHOLD=10

# Price changes (защита любого изменения цены)
# PRICE_MIN_UZS=
# PRICE_MAX_STEP_PERCENT=5

# Автоцены: запуск 09:30 и 19:30 по Ташкенту. По умолчанию — только рекомендации в Telegram.
# AUTO_PRICING_ENABLED=true
# Реально менять цены (включать после недели рекомендаций):
AUTO_PRICING_APPLY=false
# AUTO_PRICING_CRON=30 9,19 * * *
# ИИ-проверка решений правил (Claude через OpenClaw); без ответа ИИ цены не меняются:
# AUTO_PRICING_AI=true
# AUTO_PRICING_AI_MODEL=claude-cli/claude-sonnet-5
# AUTO_PRICING_MIN_MARGIN_PERCENT=15
# AUTO_PRICING_MAX_CHANGES=20
# Доп. локомотивы (SKU ID через запятую) сверх лицевых:
# AUTO_PRICING_LOCOMOTIVES=
# Доп. параметры запроса getProducts кабинета, если Uzum их требует (например filter=active&sortBy=id&order=descending):
# AUTO_PRICING_STOCK_QUERY=

# Агент по рекламе: советы в Telegram раз в день (только советы, в кабинете ничего не меняет).
# AD_AGENT_ENABLED=true
# AD_AGENT_CRON=0 10 * * *
# AD_AGENT_MAX_DRR_PERCENT=10
# AD_AGENT_AI=true
# AD_AGENT_AI_MODEL=claude-cli/claude-sonnet-5
